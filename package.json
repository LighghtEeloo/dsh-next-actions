{
  "name": "dsh-next-actions",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shows 1–3 clickable next actions under replies; clicking one fills the input draft, never sends.",
  "icon": "./icon.svg",
  "author": "LighghtEeloo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LighghtEeloo/dsh-next-actions.git"
  },
  "homepage": "https://github.com/LighghtEeloo/dsh-next-actions#readme",
  "bugs": {
    "url": "https://github.com/LighghtEeloo/dsh-next-actions/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "next-actions",
    "suggestions"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/normalize.js",
    "locale/*.json",
    "icon.svg",
    "DESIGN.md",
    "assets/*.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
